# Porta HTTP da API
PORT=3001
# Segredo de assinatura do JWT (troque em qualquer ambiente compartilhado)
JWT_SECRET=rateiojusto-segredo-dev
# Validade do token (padrão: 2h)
JWT_EXPIRES_IN=2h
# Origem permitida no CORS (frontend)
CORS_ORIGIN=*
# Habilita POST /api/test/reset (padrão: true fora de produção)
ENABLE_TEST_ROUTES=true
